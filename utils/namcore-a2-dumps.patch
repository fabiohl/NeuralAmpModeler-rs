diff --git a/NAM/debug_dump_a2.cpp b/NAM/debug_dump_a2.cpp
new file mode 100644
index 0000000..944182d
--- /dev/null
+++ b/NAM/debug_dump_a2.cpp
@@ -0,0 +1,263 @@
+#include "debug_dump_a2.h"
+
+#ifdef NAM_A2_DUMP_ENABLE
+
+#include <cstdlib>
+#include <bit>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <filesystem>
+#include <fstream>
+
+namespace nam
+{
+namespace debug
+{
+namespace a2dump
+{
+namespace
+{
+
+// Capture targets of the KB-A2-MAX investigation (wavenet_a2_max.nam):
+//   dump_array0        — condition_dsp LayerArray 0 residual output (GetLayerOutputs),
+//                        3 channels × 2048 frames
+//   dump_rechannel     — condition_dsp LayerArray 0 _head_rechannel output, delivered
+//                        as head_inputs to LayerArray 1, 4 channels × 2048 frames
+//   dump_condition_dsp — top-level WaveNet _condition_output blocks feeding the main
+//                        FiLM stages, 8 channels × 2048 frames
+//   dump_film          — all 16 FiLM slots of the main WaveNet layer array
+//                        (single layer array, 2 layers × 8 families, in order):
+//                        family 0 = conv_pre_film           (4 channels)
+//                        family 1 = conv_post_film          (4 channels)
+//                        family 2 = input_mixin_pre_film    (8 channels = condition_size)
+//                        family 3 = input_mixin_post_film   (4 channels)
+//                        family 4 = activation_pre_film     (4 channels)
+//                        family 5 = activation_post_film    (4 channels)
+//                        family 6 = layer1x1_post_film      (4 channels)
+//                        family 7 = head1x1_post_film       (4 channels)
+//                        Frame-major interleave: frame outermost, then slot 0..15, then
+//                        channel. Per-frame floats = 14*4 + 2*8 = 72.
+//
+// All files are appended frame-major as f32 little-endian, one render block per call.
+// Prewarm frames are excluded via SetPrewarmContext and never counted.
+
+constexpr int kNumFilmSlots = 16;
+constexpr int kNumFilmFamilies = 8;
+constexpr int kFilmMainInputMixinPre = 2; // family index whose input dim == condition_size
+
+struct Writer
+{
+  std::ofstream stream;
+  long frames = 0;
+  long channels = -1;
+};
+
+static_assert(std::endian::native == std::endian::little, "A2 dumps require little-endian f32");
+bool gEnabled = false;
+std::filesystem::path gDir;
+std::unordered_map<std::string, Writer> gWriters;
+
+thread_local bool gInPrewarm = true;
+thread_local int gDepth = 0;
+
+struct FilmBlock
+{
+  bool active = false;
+  int num_frames = -1;
+  std::vector<std::vector<float>> slots;
+};
+thread_local FilmBlock gFilmBlock;
+
+int film_expected_channels(const int slot)
+{
+  if (slot < 0 || slot >= kNumFilmSlots)
+    throw std::runtime_error("A2 dump: invalid FiLM slot " + std::to_string(slot));
+  const long family = slot % kNumFilmFamilies;
+  // Slot input dims of the a2_max main layers: input_mixin_pre operates on the
+  // condition tensor itself (condition_size=8); every other family modulates a
+  // bottleneck/channels-sized block (4 channels).
+  return family == kFilmMainInputMixinPre ? 8 : 4;
+}
+
+void init()
+{
+  if (gEnabled)
+    return;
+  const char* dir_str = std::getenv("NAM_A2_DUMP_DIR");
+  if (dir_str == nullptr || dir_str[0] == '\0')
+    return;
+  const std::filesystem::path dir(dir_str);
+  if (!std::filesystem::is_directory(dir))
+    throw std::runtime_error("NAM_A2_DUMP_DIR is set but not a directory: " + dir.string());
+  gDir = dir;
+  gEnabled = true;
+  std::atexit(
+    []()
+    {
+      std::ofstream meta(gDir / "capture_meta.txt", std::ios::out | std::ios::trunc);
+      for (const auto& entry : gWriters)
+        meta << entry.first << " frames=" << entry.second.frames << " channels=" << entry.second.channels << "\n";
+    });
+}
+
+void writer_append(const char* tensor, const long channels, const float* values, const int num_frames)
+{
+  init();
+  if (!gEnabled)
+    return;
+  Writer& writer = gWriters[tensor];
+  if (!writer.stream.is_open())
+  {
+    writer.stream.open((gDir / tensor).string(), std::ios::out | std::ios::binary | std::ios::trunc);
+    if (!writer.stream.is_open())
+      throw std::runtime_error(std::string("A2 dump: cannot open dump file for ") + tensor);
+  }
+  if (writer.channels == -1)
+    writer.channels = channels;
+  else if (writer.channels != channels)
+    throw std::runtime_error(std::string("A2 dump: channel-count mismatch for ") + tensor);
+  writer.frames += num_frames;
+  writer.stream.write(reinterpret_cast<const char*>(values),
+                      static_cast<std::streamsize>(num_frames) * channels * sizeof(float));
+  writer.stream.flush();
+  if (!writer.stream.good())
+    throw std::runtime_error(std::string("A2 dump: I/O error while writing ") + tensor);
+}
+
+// Captures an (rows x num_frames) Eigen frame block into a frame-major f32 buffer.
+void capture_block(const Eigen::Ref<const Eigen::MatrixXf>& data, const int num_frames, std::vector<float>& out)
+{
+  const long rows = data.rows();
+  out.resize(static_cast<size_t>(rows) * static_cast<size_t>(num_frames));
+  for (long f = 0; f < num_frames; f++)
+    for (long c = 0; c < rows; c++)
+      out[static_cast<size_t>(f) * rows + c] = data(c, f);
+}
+
+bool film_window_active()
+{
+  init();
+  return gEnabled && gDepth == 1 && !gInPrewarm;
+}
+
+} // namespace
+
+void SetPrewarmContext(const bool in_prewarm)
+{
+  if (gDepth != 0)
+    throw std::runtime_error("A2 dump: SetPrewarmContext called inside a capture scope");
+  gInPrewarm = in_prewarm;
+}
+
+ProcessDepthScope::ProcessDepthScope() { gDepth += 1; }
+ProcessDepthScope::~ProcessDepthScope() { gDepth -= 1; }
+
+void DumpTensor(const char* tensor, const Eigen::Ref<const Eigen::MatrixXf>& data, const int num_frames,
+                const long expected_channels)
+{
+  init();
+  if (!gEnabled || gInPrewarm)
+    return;
+  if (expected_channels <= 0 || data.rows() != expected_channels)
+    throw std::runtime_error(std::string("A2 dump: ") + tensor
+                             + ": unexpected channel count " + std::to_string(data.rows()) + " (expected "
+                             + std::to_string(expected_channels) + ")");
+  if (num_frames <= 0 || data.cols() < num_frames)
+    throw std::runtime_error(std::string("A2 dump: ") + tensor + ": num_frames outside buffer bounds");
+  std::vector<float> buffer;
+  capture_block(data, num_frames, buffer);
+  writer_append(tensor, expected_channels, buffer.data(), num_frames);
+}
+
+void DumpConditionLayerArrayTensor(const char* tensor, const Eigen::Ref<const Eigen::MatrixXf>& data,
+                                   const int num_frames, const long expected_channels)
+{
+  init();
+  // Only the first LayerArray of a nested condition WaveNet may emit these anchors.
+  if (!(gEnabled && gDepth == 2 && !gInPrewarm))
+    return;
+  if (expected_channels <= 0 || data.rows() != expected_channels)
+    throw std::runtime_error(std::string("A2 dump: ") + tensor
+                             + ": unexpected channel count " + std::to_string(data.rows()) + " (expected "
+                             + std::to_string(expected_channels) + ")");
+  if (num_frames <= 0 || data.cols() < num_frames)
+    throw std::runtime_error(std::string("A2 dump: ") + tensor + ": num_frames outside buffer bounds");
+  std::vector<float> buffer;
+  capture_block(data, num_frames, buffer);
+  writer_append(tensor, expected_channels, buffer.data(), num_frames);
+}
+
+void BeginFilmBlock(const int num_frames)
+{
+  if (!film_window_active())
+    return;
+  if (gFilmBlock.active)
+    throw std::runtime_error("A2 dump: nested FiLM capture block");
+  if (num_frames <= 0)
+    throw std::runtime_error("A2 dump: BeginFilmBlock with invalid num_frames");
+  gFilmBlock.active = true;
+  gFilmBlock.num_frames = num_frames;
+  gFilmBlock.slots.assign(static_cast<size_t>(kNumFilmSlots), {});
+}
+
+void DumpFilmSlot(const int slot, const Eigen::Ref<const Eigen::MatrixXf>& out, const int num_frames)
+{
+  if (!film_window_active())
+    return;
+  if (!gFilmBlock.active)
+    throw std::runtime_error("A2 dump: DumpFilmSlot called outside a FiLM capture block");
+  if (num_frames != gFilmBlock.num_frames)
+    throw std::runtime_error("A2 dump: FiLM slot frame count does not match the capture block");
+  if (slot < 0 || slot >= kNumFilmSlots)
+    throw std::runtime_error("A2 dump: invalid FiLM slot " + std::to_string(slot));
+  const int expected = film_expected_channels(slot);
+  if (out.rows() != expected || out.cols() < num_frames)
+    throw std::runtime_error("A2 dump: FiLM slot " + std::to_string(slot) + ": unexpected shape "
+                             + std::to_string(out.rows()) + "x" + std::to_string(num_frames));
+  capture_block(out, num_frames, gFilmBlock.slots[static_cast<size_t>(slot)]);
+}
+
+void EndFilmBlock()
+{
+  if (!film_window_active())
+    return;
+  if (!gFilmBlock.active)
+    throw std::runtime_error("A2 dump: EndFilmBlock without BeginFilmBlock");
+  long per_frame = 0;
+  for (int slot = 0; slot < kNumFilmSlots; slot++)
+  {
+    const auto& captured = gFilmBlock.slots[static_cast<size_t>(slot)];
+    if (captured.empty())
+      throw std::runtime_error("A2 dump: FiLM slot " + std::to_string(slot) + " was never captured in the block");
+    if (static_cast<long>(captured.size()) != static_cast<long>(gFilmBlock.num_frames) * film_expected_channels(slot))
+      throw std::runtime_error("A2 dump: FiLM slot " + std::to_string(slot) + " storage size mismatch");
+    per_frame += film_expected_channels(slot);
+  }
+  std::vector<float> interleaved;
+  interleaved.resize(static_cast<size_t>(gFilmBlock.num_frames) * static_cast<size_t>(per_frame));
+  {
+    size_t pos = 0;
+    for (int f = 0; f < gFilmBlock.num_frames; f++)
+      for (int slot = 0; slot < kNumFilmSlots; slot++)
+      {
+        const int ch = film_expected_channels(slot);
+        const std::vector<float>& captured = gFilmBlock.slots[static_cast<size_t>(slot)];
+        std::memcpy(interleaved.data() + pos, captured.data() + static_cast<size_t>(f) * ch,
+                    static_cast<size_t>(ch) * sizeof(float));
+        pos += static_cast<size_t>(ch);
+      }
+  }
+  writer_append("dump_film.bin", per_frame, interleaved.data(), gFilmBlock.num_frames);
+  gFilmBlock.active = false;
+  gFilmBlock.slots.clear();
+}
+
+} // namespace a2dump
+} // namespace debug
+} // namespace nam
+
+#endif // NAM_A2_DUMP_ENABLE
diff --git a/NAM/debug_dump_a2.h b/NAM/debug_dump_a2.h
new file mode 100644
index 0000000..f370c73
--- /dev/null
+++ b/NAM/debug_dump_a2.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <Eigen/Dense>
+
+// debug_dump_a2.h — Opt-in intermediate-tensor capture for the KB-A2-MAX
+// (wavenet_a2_max.nam) C++ parity investigation.
+//
+// Capture rules:
+// - The 4 anchor dumps are dump_array0, dump_rechannel, dump_condition_dsp,
+//   dump_film, appended frame-major as f32 little-endian Per frame, all file
+//   bytes go one frame at a time (slot-major inside dump_film).
+// - Compile gate: only compiles in when NAM_A2_DUMP_ENABLE is defined
+//   (CMake option NAM_A2_DUMPS, OFF by default). Without it every entry point
+//   is an empty inline no-op, so release behavior and numerics are identical.
+// - Runtime gate: even when compiled in, files are only written when the
+//   environment variable NAM_A2_DUMP_DIR points to an existing directory;
+//   the default is capture disabled.
+// - Prewarm frames (DSP::prewarm processing a silent input buffer) are always
+//   excluded; only rendered frames are captured.
+
+namespace nam
+{
+namespace debug
+{
+#ifdef NAM_A2_DUMP_ENABLE
+namespace a2dump
+{
+void SetPrewarmContext(const bool in_prewarm);
+class ProcessDepthScope
+{
+public:
+  ProcessDepthScope();
+  ~ProcessDepthScope();
+  ProcessDepthScope(const ProcessDepthScope&) = delete;
+  ProcessDepthScope& operator=(const ProcessDepthScope&) = delete;
+};
+void DumpTensor(const char* tensor, const Eigen::Ref<const Eigen::MatrixXf>& data, const int num_frames,
+                const long expected_channels);
+// Anchors inside the condition DSP's own layer-array loop (capture gate requires
+// WaveNet process nesting depth == 2, i.e., the first LayerArray of a nested
+// condition WaveNet).
+void DumpConditionLayerArrayTensor(const char* tensor, const Eigen::Ref<const Eigen::MatrixXf>& data,
+                                   const int num_frames, const long expected_channels);
+void DumpFilmSlot(const int slot, const Eigen::Ref<const Eigen::MatrixXf>& out, const int num_frames);
+void BeginFilmBlock(const int num_frames);
+void EndFilmBlock();
+} // namespace a2dump
+#else
+namespace a2dump
+{
+inline void SetPrewarmContext(bool) {}
+class ProcessDepthScope
+{
+public:
+  ProcessDepthScope() {}
+  ~ProcessDepthScope() {}
+  ProcessDepthScope(const ProcessDepthScope&) = delete;
+  ProcessDepthScope& operator=(const ProcessDepthScope&) = delete;
+};
+inline void DumpTensor(const char*, const Eigen::Ref<const Eigen::MatrixXf>&, int, long) {}
+inline void DumpConditionLayerArrayTensor(const char*, const Eigen::Ref<const Eigen::MatrixXf>&, int, long) {}
+inline void DumpFilmSlot(int, const Eigen::Ref<const Eigen::MatrixXf>&, int) {}
+inline void BeginFilmBlock(int) {}
+inline void EndFilmBlock() {}
+} // namespace a2dump
+#endif
+} // namespace debug
+} // namespace nam
