# Temporary / OS junk
*.tmp*
.DS_Store
Thumbs.db
repomix-*.xml
*.bak
*.swp
*.log

# Defense in depth: never stage nested .git/ metadata under any subdirectory
**/.git/

# Rust build artifacts
/target
.performance-baselines/

# Scratch / ad-hoc debug prototypes
scratch/
scratch
scratch.rs

# Ad-hoc root binaries and scripts (keep the tests/ tree)
/test_*
!/tests/

# Golden vectors for numerical validation (do not ignore)
!tests/fixtures/*.bin

# Ignore stray JSON except test fixtures
*.json
!tests/fixtures/**/*.json
# Canonical quality-contract authority is JSON (R-01, S1.T3) — do not ignore
!docs/quality-contract.json

# Proptest regression files (auto-generated)
*.proptest-regressions

# cargo-fuzz: keep targets/config; ignore evolved corpus and crash artifacts
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/Cargo.lock

# cargo-mutants artifacts
.mutants/
.out/
mutants.out.old/

# Local-only third-party area (populated by utils/setup-third-party.sh).
# Holds pinned upstream mirrors (NeuralAmpModelerCore, NeuralAmpModelerPlugin)
# and the optional community_models symlink — never commit vendor trees.
/third-party

# C++ render-tool build artifacts
/tests/fixtures/render_ir
/build/

# Temporary files from golden-vector generation scripts
/tests/fixtures/.temp_golden/
/tests/fixtures/.temp_live/

# f64 anchor regeneration junk (never commit .new / backups next to canonical bins)
tests/fixtures/f64_anchors/*.bin.new
tests/fixtures/f64_anchors/*.bin.old
tests/fixtures/f64_anchors/*.bin.old.backup
tests/fixtures/f64_anchors/*.backup

# Python bytecode from fixture/utility scripts
__pycache__/
*.pyc

# Local IDE tooling
/.kilo/
