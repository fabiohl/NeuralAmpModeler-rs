#
# Single source of truth for pinned upstream vendor versions used by local
# NeuralAmpModeler-rs development (parity, golden generation, cabsim C++ xref).
# Version-controlled in this repository. Trees are checked out under
# third-party/ by utils/setup-third-party.sh (gitignored; never committed).
#
# Sourced by shell scripts via:
#   source "$PROJECT_DIR/variables.env"
# Override the location via NAM_VARIABLES_ENV if necessary.

# =============================================================================
# Pinned vendor versions
# =============================================================================

# Source of truth for the pinned reference NAMcore version: the NAM_CORE_TAG
# and NAM_CORE_COMMIT values below (in this file). Do not infer the pinned
# version from the upstream mirror's NAM/version.h: it may diverge from the pin
# and must not be used for that purpose. The mirror is read-only and must never
# be edited. Pinned reference: v0.6.0 (commit 0b3d3c97b0859a3a8c92a8628c4dd89a25eb5842).
NAM_CORE_REPO="https://github.com/sdatkinson/NeuralAmpModelerCore.git"
NAM_CORE_TAG="v0.6.0"
NAM_CORE_COMMIT="0b3d3c97b0859a3a8c92a8628c4dd89a25eb5842"

NAM_PLUGIN_REPO="https://github.com/sdatkinson/NeuralAmpModelerPlugin.git"
NAM_PLUGIN_TAG="v0.7.15"
NAM_PLUGIN_COMMIT="96337e9ab6e3beb619459779bbb5c47e1b04d8c4"
